{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flask: run dev",
      "type": "shell",
      "command": "source .venv/bin/activate && flask --app wsgi run --host 0.0.0.0 --debugger --reload",
      "options": {
        "env": {
          "FLASK_APP": "wsgi.py",
          "FLASK_ENV": "development"
        },
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
